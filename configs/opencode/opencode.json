{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "lead",
  "agent": {
    "lead": {
      "model": "openai/gpt-5.6-terra"
    },
    "coder": {
      "model": "openai/gpt-5.6-terra"
    },
    "reviewer": {
      "model": "openai/gpt-5.6-terra"
    },
    "analyst": {
      "model": "openai/gpt-5.6-luna"
    },
    "designer": {
      "model": "openai/gpt-5.6-luna"
    },
    "tester": {
      "model": "openai/gpt-5.6-luna"
    },
    "scribe": {
      "model": "openai/gpt-5.6-luna"
    },
    "context-capture": {
      "model": "openai/gpt-5.6-luna"
    },
    "kb-writer": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "permission": {
    "skill": "allow",
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "~/.agents/**": "allow",
      "*": "ask"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ]
}
